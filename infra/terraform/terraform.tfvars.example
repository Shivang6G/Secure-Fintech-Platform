# Copy this file to terraform.tfvars and adjust as needed.
# terraform.tfvars is gitignored — never commit real values there.

aws_region   = "ap-south-1"
environment  = "dev"
project_name = "titanium-core"

# Leave defaults unless you have a reason to change subnet ranges.
vpc_cidr              = "10.20.0.0/16"
public_subnet_cidrs   = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs  = ["10.20.11.0/24", "10.20.12.0/24"]
availability_zones    = ["ap-south-1a", "ap-south-1b"]

db_name           = "fintech_engine"
db_username       = "engine_admin"
db_instance_class = "db.t4g.micro" # Free-Tier eligible for the first 12 months

backend_cpu            = 256
backend_memory         = 512
backend_desired_count  = 1
backend_image_tag      = "latest"
